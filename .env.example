# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must never be committed.

# Supabase project URL (public — safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://xeldzlyrkeolyefmusgc.supabase.co

# Supabase anon/public key (browser-exposed, protected by Row Level Security).
# Get it from: Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL — server-only, NEVER expose to the browser, NEVER commit.
# Needed later for trusted server-side operations (e.g. kiosk ticket creation
# via a privileged RPC). Bypasses RLS, so guard it carefully.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
